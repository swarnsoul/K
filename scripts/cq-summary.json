  {
    "type": "text",
    "id": "443:226",
    "name": "Manage"
  },
  {
    "type": "text",
    "id": "443:227",
    "name": "Separate journeys for creators and users keep navigation focused while supporting both goals."
  },
  {
    "type": "frame",
    "id": "443:228",
