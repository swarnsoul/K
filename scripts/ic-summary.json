  {
    "type": "text",
    "id": "408:85",
    "name": "Solution"
  },
  {
    "type": "text",
    "id": "408:83",
    "name": "InfluCrush reimagines creator–community relationships through a trust-first experience. Instead of open messaging, the platform enables creators to control access while allowing users to discover, connect, subscribe, and communicate through a structured interaction model."
  },
  {
    "type": "text",
    "id": "408:82",
    "name": "Core Experience"
  },
  {
    "type": "text",
    "id": "408:86",
    "name": "Discover verified creators based on preferences. Request Access instead of sending unrestricted messages. Subscribe to unlock meaningful conversations. Connect through a private and intentional chat experience."
  },
  {
    "type": "frame",
    "id": "382:96",
    "name": "Frame 103"
  },
  {
    "type": "text",
    "id": "382:98",
    "name": "High-Fidelity Design"
  },
  {
    "type": "text",
    "id": "382:99",
    "name": "The interface uses a premium dark theme, bold visual hierarchy, and minimal interactions to create an immersive experience while keeping the focus on profiles and conversations."
  },
