  {
    "id": "354:62",
    "name": "Frame 95",
    "x": 0,
    "y": 4364,
    "width": 1440,
    "height": 309,
    "texts": [
      {
        "id": "354:64",
        "text": "Opportunity",
        "x": 0,
        "y": 0,
        "w": 164,
        "h": 48
      },
      {
        "id": "354:65",
        "text": "The rise of the creator economy has changed how people build trust online, but meaningful interactions still happen through public comments or overcrowded inboxes. Existing dating platforms solve discovery, while social platforms solve reach. Neither is designed for intentional relationships between creators and their communities. InfluCrush explores the opportunity to bridge that gap by combining creator control, trust-first interactions, and a premium relationship experience.",
        "x": 81,
        "y": 98.5,
        "w": 588,
        "h": 175
      }
    ],
    "shapes": []
  },
  {
    "id": "354:66",
    "name": "Frame 96",
    "x": 0,
    "y": 4673,
    "width": 1440,
    "height": 257,
    "texts": [
      {
        "id": "354:76",
        "text": "Creator Economy",
        "x": 78,
        "y": 43.5,
        "w": 155,
        "h": 48
      },
      {
        "id": "354:78",
        "text": "Creators need meaningful interactions not thousands of unsolicited messages.",
        "x": 35,
        "y": 101.5,
        "w": 241,
        "h": 75
      },
      {
        "id": "354:82",
        "text": "Intentional Relationships",
        "x": 44,
        "y": 43.5,
        "w": 223,
        "h": 48
      },
      {
        "id": "354:83",
        "text": "Users value quality conversations over endless swiping.",
        "x": 32,
        "y": 101.5,
        "w": 247,
        "h": 75
      },
      {
        "id": "354:86",
        "text": "Creator Control",
        "x": 50.5,
        "y": 43.5,
        "w": 210,
        "h": 48
      },
      {
        "id": "354:87",
        "text": "Creators decide who can connect, when, and under what conditions.",
        "x": 35,
        "y": 101.5,
        "w": 241,
        "h": 75
      },
      {
        "id": "354:90",
        "text": "Premium Access",
        "x": 21.5,
        "y": 43.5,
        "w": 268,
        "h": 48
      },
      {
        "id": "354:91",
        "text": "Monetization becomes part of the experience instead of interrupting it.",
        "x": 35,
        "y": 101.5,
        "w": 241,
        "h": 75
      }
    ],
    "shapes": []
  },
  {
    "id": "358:92",
    "name": "Frame 97",
    "x": 0,
    "y": 4930,
    "width": 1440,
    "height": 221,
    "texts": [
      {
        "id": "358:94",
        "text": "How I validated the opportunity",
        "x": 0,
        "y": 0,
        "w": 423,
        "h": 48
      },
      {
        "id": "358:95",
        "text": "Competitive analysis of Tinder, Bumble, Instagram, and Hinge. Product teardown of onboarding, discovery, and messaging flows. Creator economy and subscription model research. Behavioral pattern analysis across social and dating platforms.",
        "x": 81,
        "y": 92,
        "w": 588,
        "h": 100
      }
    ],
    "shapes": []
  },
  {
    "id": "358:99",
    "name": "Frame 98",
    "x": 0,
    "y": 5151,
    "width": 1440,
    "height": 221,
    "texts": [
      {
        "id": "358:101",
        "text": "Key Insights",
        "x": 0,
        "y": 0,
        "w": 164,
        "h": 48
      },
      {
        "id": "358:102",
        "text": "Users value meaningful conversations over endless swiping. Creators need control over who can contact them. Trust should be established before conversations begin. Monetization works best when it enhances the experience, not interrupts it.",
        "x": 733,
        "y": 92,
        "w": 602,
        "h": 100
      }
    ],
    "shapes": []
  },
