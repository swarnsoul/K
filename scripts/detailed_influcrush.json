  {
    "id": "408:80",
    "name": "Frame 108",
    "x": 0,
    "y": 7439,
    "width": 1440,
    "height": 396,
    "texts": [
      {
        "id": "408:85",
        "text": "Solution",
        "x": 0,
        "y": 0,
        "w": 111,
        "h": 48
      },
      {
        "id": "408:83",
        "text": "InfluCrush reimagines creator–community relationships through a trust-first experience. Instead of open messaging, the platform enables creators to control access while allowing users to discover, connect, subscribe, and communicate through a structured interaction model.",
        "x": 81,
        "y": 103,
        "w": 791,
        "h": 75
      },
      {
        "id": "408:82",
        "text": "Core Experience",
        "x": 0,
        "y": 0,
        "w": 224,
        "h": 48
      },
      {
        "id": "408:86",
        "text": "Discover verified creators based on preferences. Request Access instead of sending unrestricted messages. Subscribe to unlock meaningful conversations. Connect through a private and intentional chat experience.",
        "x": 81,
        "y": 256,
        "w": 791,
        "h": 100
      }
    ],
    "shapes": []
  },
